  "purpose": "VectorTube side-project module shape: user-seeded YouTube transcript sources are turned into a layer-aware mini-space for VectorFL without direct main-space mutation.",
  "core_identity": {
    "not_a_summarizer": true,
    "not_bulk_crawler": true,
    "seed_bounded_calibrated_search": true,
    "layer_reading_before_summary": true,
    "mini_space_before_main_space": true,
    "receipts_are_evidence_not_authority": true
  },
  "canonical_flow": [
    {
      "stage": "S0_SEED_INTAKE",
      "input": "user-designated YouTube URL/ID",
      "output": "seed_source_card + raw/timestamped transcript",
      "gate": "transcript must be non-empty; source is evidence not authority"
    },
    {
      "stage": "S1_SEED_SPACE_READING",
      "input": "seed transcript",
      "output": "seed claims/layers/LACL/tensions/confusion risks",
      "gate": "must include timestamped claims and changed judgment; summary-only fails"
    },
    {
      "stage": "S2_BOUNDED_SEARCH_PLAN",
      "input": "seed layer reading",
      "output": "max 3 query intents + budget",
      "gate": "query must derive from seed layers, not generic curiosity"
    },
    {
      "stage": "S3_CANDIDATE_SEARCH_ONLY",
      "input": "bounded queries",
      "output": "candidate URLs/metadata only",
      "gate": "no transcript fetch yet; candidate count capped"
    },
    {
      "stage": "S4_APPROVED_EXPANSION_FETCH",
      "input": "approved candidates or safe default approval lane",
      "output": "raw/timestamped expansion transcripts + source cards",
      "gate": "fetch count capped; no bulk crawl"
    },
    {
      "stage": "S5_LAYER_CARD_GENERATION",
      "input": "each source transcript",
      "output": "9-lens layer-grounded claim table",
      "gate": "L0-L8 coverage required; timestamp grounding required"
    },
    {
      "stage": "S6_COUNTER_FAILURE_GATE",
      "input": "current mini-space bias/tension state",
      "output": "negative-validation source or explicit missing-counter marker",
      "gate": "if pro-source/vendor bias high, add one counter/failure source before template/push"
    },
    {
      "stage": "S7_LAYERED_MINI_SPACE_COMPOSITION",
      "input": "seed + expansions + counter + layer cards",
      "output": "cross-source agreement/tension/drift table",
      "gate": "PASS_WITH_CAUTION or stronger; blockers recorded"
    },
    {
      "stage": "S8_HOLD_PUSH_PACKET",
      "input": "layered mini-space",
      "output": "VectorFL/Codex read-only matching request + HOLD packet",
      "gate": "no main-space mutation; no authority/current-position/registry mutation"
    }
  ],
  "default_budgets": {
