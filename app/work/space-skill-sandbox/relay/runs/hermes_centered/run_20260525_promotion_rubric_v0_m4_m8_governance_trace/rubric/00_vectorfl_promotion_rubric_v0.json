      ],
      "allowed_actions": [
        "precise reading",
        "relation map",
        "gap map",
        "bounded Gemini exploration",
        "Codex placement/conflict/gap review",
        "dry-run precheck"
      ],
      "blocked_actions": [
        "authority/current-position/registry mutation",
        "unreviewed merge",
        "file move except explicit cleanup apply",
        "treating popularity/agent output as authority"
