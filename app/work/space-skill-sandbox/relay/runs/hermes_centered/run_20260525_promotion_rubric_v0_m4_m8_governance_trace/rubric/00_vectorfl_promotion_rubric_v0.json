      "exit_to_authority": [
        "explicit user approval",
        "M4 authority boundary review",
        "M8 post-review trace",
        "rollback path exists where applicable",
        "current-position/registry target identified and frozen before mutation"
      ]
    },
    "AUTHORITY": {
      "meaning": "공식 기준/현재위치/registry 등에 반영되는 권위 자산. 가장 좁고 엄격한 상태.",
      "entry_requirements": [
