  "global_principles": [
    "receipt/candidate/spec/packet은 authority가 아니다",
    "authority/current-position/registry mutation은 별도 명시 승인 전 HOLD",
    "promotion은 상태 전환이며 파일 이동이나 registry 수정을 자동으로 의미하지 않는다",
    "M4는 승격/보류/충돌/권위 경계 판단을 담당한다",
    "M8은 validation/receipt/trace/timing/drift/quality evidence를 제공한다",
    "M2/M7/M8/M4 없이는 폴더 정리 apply 금지",
    "Codex/Gemini live call 없이도 read-only handoff surface는 만들 수 있다"
  ],
  "status_definitions": {
    "INBOX": {
      "meaning": "검역/회수 대기 상태. 자산은 공간 안으로 들어왔지만 아직 의미·위치·권위가 확정되지 않음.",
      "allowed_inputs": [
        "external/user original",
        "run artifact",
        "receipt",
        "candidate note",
        "mini-space",
        "handoff packet",
        "validation output"
      ],
      "entry_requirements": [
        "source pointer exists",
        "provenance/evidence/interpretation separation attempted",
        "authority claim explicitly marked NOT_AUTHORITY",
        "HOLD marker present",
        "M8 minimal receipt or source hash present"
      ],
      "allowed_actions": [
        "read",
        "classify",
        "add pointer",
        "create receipt",
        "route to Codex/Gemini/Hermes",
        "mark missing evidence"
      ],
      "blocked_actions": [
        "authority mutation",
        "registry/current-position mutation",
        "folder move/archive",
        "promotion without review",
        "secret preservation"
      ],
      "exit_to_candidate": [
        "source exists and readable",
        "M2 route candidate exists",
        "M3 precheck if execution-related",
        "M8 minimal validation exists",
        "no immediate authority-sensitive blocker"
      ]
    },
    "CANDIDATE": {
      "meaning": "공간에 유용할 가능성이 확인된 후보. 아직 core/authority는 아님.",
