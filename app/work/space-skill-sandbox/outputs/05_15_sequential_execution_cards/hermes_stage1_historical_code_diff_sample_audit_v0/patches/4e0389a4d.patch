+def _cli_adapter(repo_root: Path, backend_kind: str) -> CodexCliAdapter:
+    if backend_kind == "codex":
+        return CodexCliAdapter(repo_root)
+    raise ValueError(f"unsupported cli backend_kind for package 1: {backend_kind}")
