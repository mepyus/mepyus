+def _dropped_weak_anchor_state(value: object) -> Dict[str, object]:
+    if value is None:
+        return {"available": False, "items": []}
+    items = [str(item).strip() for item in (value or []) if str(item).strip()]
+    return {"available": True, "items": items[:10]}
