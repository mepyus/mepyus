type CliReadableReturn = {
  session_id?: string;
  backend_kind?: string;
  task_type?: string;
  status?: string;
  purpose_text?: string;
  marks?: string[];
  mark_history?: Array<{ mark: string; marked_at: string; source?: string }>;
  structured_return_preview?: string;
  deposit_candidate_preview?: string;
  session_path?: string;
  structured_return_path?: string;
  deposit_candidate_path?: string;
};

type CliHostState = {
  latest_readable_return?: CliReadableReturn;
  recent_readable_returns?: CliReadableReturn[];
  deposit_ready_returns?: CliReadableReturn[];
};

function shortId(id?: string) {
  return id ? id.replace("cli_", "") : "none";
}

function routeLabel(marks?: string[]) {
  if (!marks?.length) return "unmarked return";
  if (marks.includes("deposit_candidate")) return "deposit candidate";
  if (marks.includes("validation_target")) return "validation target";
  if (marks.includes("implementation_return")) return "implementation return";
  if (marks.includes("reread_target")) return "reread target";
  return marks.join(", ");
}

function SurfaceCliCard({ title, subtitle, tone = "indigo", children }: any) {
  const toneClass = tone === "emerald"
    ? "border-emerald-500/15 bg-emerald-500/[0.03]"
    : tone === "sky"
      ? "border-sky-500/15 bg-sky-500/[0.03]"
      : "border-indigo-500/15 bg-indigo-500/[0.03]";
  return (
    <Card className={`rounded-[28px] ${toneClass} text-slate-100 shadow-2xl`}>
      <CardHeader className="border-b border-white/5 pb-4">
        <div className="flex items-center justify-between gap-4">
          <div>
            <CardTitle className="text-sm font-bold text-white">{title}</CardTitle>
            <CardDescription className="mt-1 text-[10px] uppercase tracking-[0.18em] text-slate-500">{subtitle}</CardDescription>
          </div>
        </div>
      </CardHeader>
      <CardContent className="space-y-3 pt-5">{children}</CardContent>
    </Card>
  );
}

function UserCliAssignmentPanel({ cli }: { cli: CliHostState }) {
  const latest = cli.latest_readable_return || {};
  const deposits = cli.deposit_ready_returns || [];
  const marks = latest.marks || [];
  const decisionText = marks.includes("deposit_candidate")
    ? "deposit 후보를 확인할 수 있음"
    : marks.includes("validation_target")
      ? "검증 대상으로 읽을 수 있음"
      : marks.includes("reread_target")
        ? "다시 읽기 대상으로 남아 있음"
        : "아직 사용자 결정 mark가 없음";

  return (
    <SurfaceCliCard title="CLI Work Assignment Signal" subtitle="VectorFL return -> user decision/work organization" tone="indigo">
      <div className="grid gap-3 lg:grid-cols-3">
        <div className="rounded-2xl border border-white/5 bg-black/20 p-4">
          <div className="text-[9px] uppercase tracking-[0.2em] text-slate-500">latest turn</div>
          <div className="mt-2 font-mono text-[10px] text-indigo-300">{shortId(latest.session_id)}</div>
          <div className="mt-2 text-xs leading-5 text-slate-300">{latest.purpose_text || "아직 CLI return 없음"}</div>
        </div>
        <div className="rounded-2xl border border-white/5 bg-black/20 p-4">
          <div className="text-[9px] uppercase tracking-[0.2em] text-slate-500">user-facing decision</div>
          <div className="mt-2 text-sm font-bold text-white">{decisionText}</div>
          <div className="mt-2 text-[10px] leading-5 text-slate-500">이 칸은 자동 배정이 아니라 사용자가 다음 작업을 조직하기 위한 신호다.</div>
        </div>
        <div className="rounded-2xl border border-white/5 bg-black/20 p-4">
          <div className="text-[9px] uppercase tracking-[0.2em] text-slate-500">deposit-ready count</div>
          <div className="mt-2 text-2xl font-black text-emerald-300">{deposits.length}</div>
          <div className="mt-1 text-[10px] text-slate-500">엔진 기록 후보로 볼 수 있는 반환 수</div>
        </div>
      </div>
    </SurfaceCliCard>
  );
}

