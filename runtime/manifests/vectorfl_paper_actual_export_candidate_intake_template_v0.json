{
  "schema_version": "vectorfl_paper_actual_export_candidate_intake_template_v0",
  "template_status": "operator_template_only_not_candidate",
  "usage_rule": "Copy this structure into runtime/manifests/vectorfl_paper_actual_export_candidate_inbox_latest_v0.json only after a real true host/export candidate with raw export evidence is available.",
  "candidate_id": "<stable-candidate-id>",
  "candidate_type": "true_host_export_candidate",
  "provenance": {
    "source_system": "<host system that emitted the export>",
